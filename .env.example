# Copy this file to .env and change the values before deploying.

PORT=3000

# ---------------------------------------------------------------------------
# Database (Postgres)
# ---------------------------------------------------------------------------
# Local development, using a Postgres you run yourself:
#   createdb shop_dev
#   DATABASE_URL=postgresql://localhost:5432/shop_dev
#
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the *Session/Transaction pooler* string (port 6543), NOT the direct
# 5432 one — serverless functions open many short-lived connections and would
# exhaust the direct connection limit.
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://localhost:5432/shop_dev

# Secret used to sign login tokens. MUST be changed for production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login stays valid
SESSION_HOURS=12

# The shop's timezone. Decides when "today" rolls over on the dashboard and
# in the daily sales reports. Any IANA zone name.
SHOP_TZ=Asia/Dhaka

# Password for the "admin" account created on first run. If unset, production
# generates a random one and prints it once to the boot log.
# ADMIN_PASSWORD=

# Set to "production" when deploying (enables secure cookies)
NODE_ENV=development
